# Web 环境变量模板（M9-23）
# 生产构建时 deploy-all.ps1 会自动注入，通常无需手填。
#   PUBLIC_WORKER_B_URL    - Worker B 公开读入口（帖子、图片、粉丝 Token、互动）
#   PUBLIC_HAILUO_ENDPOINT - 旧部署 / 本地调试回退；生产默认留空
#   PUBLIC_REGISTRY_URL    - 注册中心 API 根地址
# 站主写层由 Pages Functions 的 WORKER_A Service Binding + INTERNAL_FORWARD_SECRET 直达 Worker A，
# 不在浏览器公开 Worker A URL。
PUBLIC_WORKER_B_URL=https://your-worker-b.workers.dev
PUBLIC_HAILUO_ENDPOINT=
PUBLIC_REGISTRY_URL=https://hailuo-registry.allovo.eu.org
