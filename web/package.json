    "astro": "^4.10.0",
    "lucide-preact": "^1.16.0",
    "preact": "^10.22.0",
    "qrcode": "^1.5.4",
    "tailwindcss": "^3.4.4"
  },
  "devDependencies": {
    "@astrojs/check": "^0.7.0",
    "@types/node": "^20.14.0",
    "@types/qrcode": "^1.5.6",
