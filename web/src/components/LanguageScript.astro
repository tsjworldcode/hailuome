---
/**
 * M-i18n-L4：壳层文案来自 chromeDict.generated.ts（由 catalogs 生成）。
 * 禁止在此手写长中英文字符串。
 */
import { CHROME_DICT, HTML_LANG } from '../lib/i18n/chromeDict.generated';
---

<script is:inline define:vars={{ CHROME_DICT, HTML_LANG }}>
  (() => {
    const dict = CHROME_DICT;
    const HTML_LANG_MAP = HTML_LANG;
    const SUPPORTED = Object.keys(HTML_LANG_MAP);

    function normalizeLanguage(value) {
      return SUPPORTED.indexOf(value) >= 0 ? value : 'zh';
    }

    function browserDefaultLanguage() {
      const list = [navigator.language].concat(navigator.languages || []);
      for (let i = 0; i < list.length; i++) {
        const tag = String(list[i] || '').toLowerCase();
        for (let j = 0; j < SUPPORTED.length; j++) {
          if (tag.startsWith(SUPPORTED[j])) return SUPPORTED[j];
        }
      }
      return 'zh';
    }

    function currentLanguage() {
      try {
        const stored = window.localStorage.getItem('hailuo:language');
        if (SUPPORTED.indexOf(stored) >= 0) return stored;
      } catch {
        return browserDefaultLanguage();
      }
      return browserDefaultLanguage();
    }

    function applyLanguageToRoot(root, lang) {
      const code = normalizeLanguage(lang);
      root.lang = HTML_LANG_MAP[code] || 'zh-CN';
      root.dataset.lang = code;
    }

    function applyLanguage(lang) {
      const code = normalizeLanguage(lang);
      document.documentElement.lang = HTML_LANG_MAP[code] || 'zh-CN';
      document.documentElement.dataset.lang = code;
      const table = dict[code] || dict.zh;
      const path = window.location.pathname.replace(/\/+$/, '') || '/';
      const titleKeyByPath = {
        '/': 'titleHome',
        '/composer': 'titleComposer',
        '/profile': 'titleProfile',
        '/follows': 'titleFollows',
        '/notes': 'titleNotes',
        '/settings': 'titleSettings',
        '/register': 'titleRegister',
        '/certify': 'titleCertify',
        '/bookmarks': 'titleBookmarks',
      };
      const titleKey = titleKeyByPath[path];
      if (titleKey && table[titleKey]) document.title = table[titleKey];
      document.querySelectorAll('[data-i18n]').forEach((el) => {
        const key = el.getAttribute('data-i18n');
        if (key && table[key]) el.textContent = table[key];
      });
      document.querySelectorAll('[data-i18n-attr]').forEach((el) => {
        const pairs = el.getAttribute('data-i18n-attr')?.split(';') || [];
        for (const pair of pairs) {
          const [attr, key] = pair.split(':');
          if (attr && key && table[key]) el.setAttribute(attr, table[key]);
        }
      });
    }

    let applyScheduled = false;

    function scheduleApplyLanguage() {
      if (applyScheduled) return;
      applyScheduled = true;
      window.requestAnimationFrame(() => {
        applyScheduled = false;
        applyLanguage(currentLanguage());
      });
    }

    applyLanguage(currentLanguage());
    window.addEventListener('DOMContentLoaded', () => applyLanguage(currentLanguage()));
    document.addEventListener('astro:before-swap', (event) => {
      if (event.newDocument) applyLanguageToRoot(event.newDocument.documentElement, currentLanguage());
    });
    document.addEventListener('astro:page-load', () => applyLanguage(currentLanguage()));
    document.addEventListener('astro:after-swap', () => applyLanguage(currentLanguage()));
    window.addEventListener('storage', (event) => {
      if (event.key === 'hailuo:language') applyLanguage(currentLanguage());
    });
    window.addEventListener('hailuo:language-change', (event) => {
      applyLanguage(normalizeLanguage(event.detail?.language));
    });
    new MutationObserver((records) => {
      if (currentLanguage() === 'zh') return;
      if (records.some((record) => record.addedNodes.length > 0)) scheduleApplyLanguage();
    }).observe(document.documentElement, { childList: true, subtree: true });
  })();
</script>
