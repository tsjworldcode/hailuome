---
import { RightRailSearch } from './RightRailSearch';
import { RegistryRecommendations } from './RegistryRecommendations';
---

<!-- M9-16：搜索 + 注册中心推荐。UX-APPLE-1：xl+ 显示（1280px+），
  与 LeftNav 在 xl+ 展开到 200px 配套；三栏总宽 LeftNav(200)+main(680)+RightRail(260)≈1140px 适配 xl。
  UX-AUDIT-10：保持 sticky top-0（与 LeftNav / Timeline 顶对齐）。
  不改 top-16：NavBar 仅 md:hidden 移动端显示，与 xl+ RightRail 不同时出现；top-16 会在桌面留 64px 空带。 -->
<aside
  class="hidden xl:flex sticky top-0 h-full w-[260px] shrink-0 flex-col gap-3 overflow-y-auto px-4 py-3 dark:border-zinc-800/80"
  aria-label="侧边栏"
  data-i18n-attr="aria-label:rightRailAria"
>
  <RightRailSearch client:idle />
  <RegistryRecommendations client:visible />
</aside>
