---
// M7-4：关注管理
// - 整页只挂一个 Preact island（client:load）；frontmatter 不做任何 fetch
//   （JWT / Worker A 地址全部走客户端运行时，避免 SSG 阶段把任何凭证或 URL 落进静态产物）
// - §F-02：本文件不引用任何 Worker A 字面量；Follows 组件内部用 auth.ts.getWorkerAUrl 运行时读取
import Layout from '../layouts/Layout.astro';
import { Follows } from '../components/Follows.tsx';
---

<Layout
  title="海螺节点 — 关注管理"
  description="海螺节点 — 关注列表与添加 / 取消关注"
  navActive="follows"
>
  <div class="w-full px-4 py-6 sm:px-6 sm:py-8">
    <Follows client:only="preact" />
  </div>
</Layout>
